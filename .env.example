# Copie para .env (desenvolvimento) ou .env.prod (servidor) e preencha.
# Nunca coloque o .env no Git.

# --- Django ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
ADMIN_URL=admin/
LOG_LEVEL=INFO

# --- Banco e Redis ---
# No docker compose de desenvolvimento estes dois já são definidos no compose.
DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana
REDIS_URL=redis://localhost:6379/0

# --- E-mail ---
# Desenvolvimento: os e-mails aparecem no terminal.
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Arcana Crochet <nao-responda@localhost>

# --- Cloudflare R2 (deixe R2_BUCKET vazio para salvar fotos no disco) ---
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=
# Domínio das imagens na política de segurança, ex.: https://fotos.seudominio.com.br
CSP_IMG_SRC=

# --- Integrações (usadas a partir da fase de transação) ---
# Sandbox do Asaas: https://sandbox.asaas.com/api/v3 · Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
# Token que você define ao cadastrar o webhook no painel do Asaas.
ASAAS_WEBHOOK_TOKEN=
# Sandbox do Melhor Envio: https://sandbox.melhorenvio.com.br · Produção: https://melhorenvio.com.br
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=
# Exigido pelo Melhor Envio no cabeçalho User-Agent: "Nome do app (email de contato)"
MELHOR_ENVIO_USER_AGENT=Arcana Crochet (seu-email@exemplo.com)

# ============================================================================
# Exemplo de .env.prod no VPS (descomente e ajuste):
# ============================================================================
# DOMINIO=arcanacrochet.com.br
# SECRET_KEY=<chave longa gerada>
# DEBUG=0
# ALLOWED_HOSTS=arcanacrochet.com.br,www.arcanacrochet.com.br,localhost
# CSRF_TRUSTED_ORIGINS=https://arcanacrochet.com.br,https://www.arcanacrochet.com.br
# SITE_URL=https://arcanacrochet.com.br
# ADMIN_URL=painel-<algo-aleatorio>/
# TRUSTED_CLIENT_IP_HEADER=CF-Connecting-IP
#
# POSTGRES_DB=arcana
# POSTGRES_USER=arcana
# POSTGRES_PASSWORD=<senha longa gerada>
# DATABASE_URL=postgres://arcana:<mesma senha>@db:5432/arcana
# REDIS_URL=redis://redis:6379/0
#
# EMAIL_URL=smtp+tls://resend:<api-key>@smtp.resend.com:587
# DEFAULT_FROM_EMAIL=Arcana Crochet <nao-responda@arcanacrochet.com.br>
