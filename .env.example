# Copy to .env (development) and fill in. Never commit .env.
# On AWS, secrets live in SSM Parameter Store (infra/configurar-segredos.sh) and the
# other variables in infra/template.yaml.

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-key
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
ADMIN_URL=admin/
LOG_LEVEL=INFO

# --- Database ---
# Development uses a local PostgreSQL (docker compose sets this for you).
DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana
# Production uses Aurora DSQL instead: set the cluster endpoint and the app connects
# with an IAM token from your AWS credentials (DATABASE_URL is then ignored).
# DSQL_ENDPOINT=<cluster-id>.dsql.sa-east-1.on.aws

# --- Email ---
# Development: emails are printed in the terminal.
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Arcana Crochet <nao-responda@localhost>

# --- Pix straight to the store's account (no payment provider, no fees) ---
# Shown in the customer's bank app. Leave empty in development to see the setup notice.
LOJA_PIX_CHAVE=
LOJA_PIX_RECEBEDOR=
LOJA_PIX_CIDADE=
# Unpaid orders are cancelled after this many hours.
LOJA_PRAZO_PAGAMENTO_HORAS=24

# --- Integrations (used from the checkout phase on) ---
# Asaas sandbox: https://sandbox.asaas.com/api/v3 · Production: https://api.asaas.com/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
# Token you choose when registering the webhook in the Asaas dashboard.
ASAAS_WEBHOOK_TOKEN=
# Melhor Envio sandbox: https://sandbox.melhorenvio.com.br · Production: https://melhorenvio.com.br
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=
# Required by Melhor Envio in the User-Agent header: "App name (contact email)"
MELHOR_ENVIO_USER_AGENT=Arcana Crochet (your-email@example.com)
