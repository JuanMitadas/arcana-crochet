# Copie para .env (desenvolvimento) e preencha. Nunca coloque o .env no Git.
# Na AWS, os segredos ficam no SSM Parameter Store (infra/configurar-segredos.sh) e as
# demais variáveis no infra/template.yaml.

# --- Django ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000
ADMIN_URL=admin/
LOG_LEVEL=INFO

# --- Banco ---
# No docker compose de desenvolvimento ele já é definido no compose.
DATABASE_URL=postgres://arcana:arcana@localhost:5432/arcana

# --- E-mail ---
# Desenvolvimento: os e-mails aparecem no terminal.
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Arcana Crochet <nao-responda@localhost>

# --- Integrações (usadas a partir da fase de transação) ---
# Sandbox do Asaas: https://sandbox.asaas.com/api/v3 · Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
# Token que você define ao cadastrar o webhook no painel do Asaas.
ASAAS_WEBHOOK_TOKEN=
# Sandbox do Melhor Envio: https://sandbox.melhorenvio.com.br · Produção: https://melhorenvio.com.br
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=
# Exigido pelo Melhor Envio no cabeçalho User-Agent: "Nome do app (email de contato)"
MELHOR_ENVIO_USER_AGENT=Arcana Crochet (seu-email@exemplo.com)
