# O tráfego chega pela Cloudflare (modo SSL "Full (strict)").
# O certificado é o "Origin Certificate" gerado no painel da Cloudflare,
# salvo em ./certs/origin.pem e ./certs/origin-key.pem no VPS (fora do Git).
{$DOMINIO}, www.{$DOMINIO} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem

	encode zstd gzip

	header {
		-Server
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Uploads locais (enquanto o R2 não estiver configurado).
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy web:8000
	}

	log {
		output stdout
		format console
	}
}
